rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 後台負責人：admins/{email} 文件存在才算（由專案擁有者在主控台或指令新增）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function orderingOpen() {
      let s = /databases/$(database)/documents/settings/main;
      return !exists(s) || get(s).data.open != false;
    }

    function validOrder(d) {
      return d.keys().hasOnly(['name', 'items', 'totalCups', 'totalPrice', 'note', 'status', 'paid', 'editKey', 'createdAt'])
        && d.keys().hasAll(['name', 'items', 'totalCups', 'totalPrice', 'note', 'status', 'paid', 'editKey', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30
        && d.totalCups is int && d.totalCups > 0 && d.totalCups <= 200
        && d.totalPrice is int && d.totalPrice >= 0 && d.totalPrice <= 20000
        && d.note is string && d.note.size() <= 200
        && d.status == 'active'
        && d.paid == false
        && d.editKey is string && d.editKey.size() >= 20 && d.editKey.size() <= 64
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow read, delete: if isAdmin();
      allow create: if orderingOpen() && validOrder(request.resource.data);
      // 負責人可改任何欄位；送單者憑同一台裝置的 editKey 只能「取消」
      allow update: if isAdmin()
        || (request.resource.data.editKey == resource.data.editKey
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledAt == request.time);
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }
  }
}
